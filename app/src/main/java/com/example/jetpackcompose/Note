@Composable
fun Greeting(name: String) {
    Text(text = "Merhaba, $name!")
}

**Row
Yatayda bileşenleri hizalar.

@Composable
fun MyRow() {
    Row {
        Text("Bileşen 1")
        Text("Bileşen 2")
    }
}

**Column
Dikeyde bileşenleri hizalar.

@Composable
fun MyColumn() {
    Column {
        Text("Bileşen 1")
        Text("Bileşen 2")
    }
}

**Box
Üst üste bileşenler yerleştirmek için kullanılır.

@Composable
fun MyBox() {
    Box {
        Text("Alt Katman")
        Text("Üst Katman")
    }
}

**LazyColumn ve LazyRow
Performanslı bir şekilde listeler oluşturur (RecyclerView’a benzer).

@Composable
fun MyLazyColumn() {
    LazyColumn {
        items(50) { index ->
            Text("Satır $index")
        }
    }
}

3. Material Design Bileşenleri
Compose, Material Design’ı doğrudan destekler ve Google'ın Material Design bileşenlerini içerir.

Button

@Composable
fun MyButton() {
    Button(onClick = { /* Yapılacak işlemler */ }) {
        Text("Tıklayın")
    }
}

Text
Basit metin gösterimi.

@Composable
fun MyText() {
    Text(text = "Merhaba Compose!")
}

TextField
Kullanıcıdan veri almak için.

@Composable
fun MyTextField() {
    var text by remember { mutableStateOf("") }
    TextField(value = text, onValueChange = { text = it }, label = { Text("Adınızı yazın") })
}

Card
İçerikleri bir kart yapısında göstermek için.

@Composable
fun MyCard() {
    Card(
        elevation = 4.dp,
        shape = RoundedCornerShape(8.dp)
    ) {
        Text("Bu bir kart.")
    }
}


4. State Yönetimi
UI’nin duruma göre güncellenmesini sağlar.
remember ve mutableStateOf ile UI durumunu kontrol edebilirsiniz.

@Composable
fun Counter() {
    var count by remember { mutableStateOf(0) }
    Button(onClick = { count++ }) {
        Text("Tıklama Sayısı: $count")
    }
}

5. Animasyonlar
Compose, animasyonlar için kolay ve güçlü araçlar sunar:

*animateFloatAsState
*animateColorAsState
*Crossfade

@Composable
fun AnimatedBox() {
    var expanded by remember { mutableStateOf(false) }
    val size by animateDpAsState(if (expanded) 200.dp else 100.dp)

    Box(
        modifier = Modifier
            .size(size)
            .background(Color.Red)
            .clickable { expanded = !expanded }
    )
}

6. Modifier
Bileşenlerin davranışını ve görünümünü özelleştirmek için kullanılır.
Örnekler: padding, background, clickable, fillMaxWidth, align, vb.

@Composable
fun MyModifierExample() {
    Text(
        text = "Modifier Örneği",
        modifier = Modifier
            .padding(16.dp)
            .background(Color.Gray)
            .clickable { /* Tıklandığında yapılacaklar */ }
    )
}

7. Tema (Theme)
Uygulama genelinde Material Design renkleri ve tipografilerini ayarlamak için kullanılır.

@Composable
fun MyTheme() {
    MaterialTheme(
        colors = MaterialTheme.colors.copy(primary = Color.Blue)
    ) {
        Text("Tema Rengi Mavi")
    }
}

8. Navigation (Navigasyon)
Jetpack Compose için Navigation Component kullanılarak ekranlar arası geçiş yapılabilir.

@Composable
fun NavigationExample() {
    val navController = rememberNavController()
    NavHost(navController, startDestination = "home") {
        composable("home") { Text("Ana Sayfa") }
        composable("details") { Text("Detaylar Sayfası") }
    }
}
