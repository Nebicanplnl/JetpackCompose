@Composable
fun Greeting(name: String) {
    Text(text = "Merhaba, $name!")
}

**Row
Yatayda bileşenleri hizalar.

@Composable
fun MyRow() {
    Row {
        Text("Bileşen 1")
        Text("Bileşen 2")
    }
}

**Column
Dikeyde bileşenleri hizalar.

@Composable
fun MyColumn() {
    Column {
        Text("Bileşen 1")
        Text("Bileşen 2")
    }
}

**Box
Üst üste bileşenler yerleştirmek için kullanılır.

@Composable
fun MyBox() {
    Box {
        Text("Alt Katman")
        Text("Üst Katman")
    }
}

**LazyColumn ve LazyRow
Performanslı bir şekilde listeler oluşturur (RecyclerView’a benzer).

@Composable
fun MyLazyColumn() {
    LazyColumn {
        items(50) { index ->
            Text("Satır $index")
        }
    }
}

3. Material Design Bileşenleri
Compose, Material Design’ı doğrudan destekler ve Google'ın Material Design bileşenlerini içerir.

Button

@Composable
fun MyButton() {
    Button(onClick = { /* Yapılacak işlemler */ }) {
        Text("Tıklayın")
    }
}

Text
Basit metin gösterimi.

@Composable
fun MyText() {
    Text(text = "Merhaba Compose!")
}

TextField
Kullanıcıdan veri almak için.

@Composable
fun MyTextField() {
    var text by remember { mutableStateOf("") }
    TextField(value = text, onValueChange = { text = it }, label = { Text("Adınızı yazın") })
}

Card
İçerikleri bir kart yapısında göstermek için.

@Composable
fun MyCard() {
    Card(
        elevation = 4.dp,
        shape = RoundedCornerShape(8.dp)
    ) {
        Text("Bu bir kart.")
    }
}


4. State Yönetimi
UI’nin duruma göre güncellenmesini sağlar.
remember ve mutableStateOf ile UI durumunu kontrol edebilirsiniz.

@Composable
fun Counter() {
    var count by remember { mutableStateOf(0) }
    Button(onClick = { count++ }) {
        Text("Tıklama Sayısı: $count")
    }
}