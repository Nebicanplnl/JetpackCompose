@Composable
fun Greeting(name: String) {
    Text(text = "Merhaba, $name!")
}

**Row
Yatayda bileşenleri hizalar.

@Composable
fun MyRow() {
    Row {
        Text("Bileşen 1")
        Text("Bileşen 2")
    }
}

**Column
Dikeyde bileşenleri hizalar.

@Composable
fun MyColumn() {
    Column {
        Text("Bileşen 1")
        Text("Bileşen 2")
    }
}

**Box

@Composable
fun MyBox() {
    Box {
        Text("Alt Katman")
        Text("Üst Katman")
    }
}