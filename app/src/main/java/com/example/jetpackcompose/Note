@Composable
fun Greeting(name: String) {
    Text(text = "Merhaba, $name!")
}

**Row
Yatayda bileşenleri hizalar.

@Composable
fun MyRow() {
    Row {
        Text("Bileşen 1")
        Text("Bileşen 2")
    }
}

**Column
Dikeyde bileşenleri hizalar.

@Composable
fun MyColumn() {
    Column {
        Text("Bileşen 1")
        Text("Bileşen 2")
    }
}

**Box
Üst üste bileşenler yerleştirmek için kullanılır.

@Composable
fun MyBox() {
    Box {
        Text("Alt Katman")
        Text("Üst Katman")
    }
}

**LazyColumn ve LazyRow
Performanslı bir şekilde listeler oluşturur (RecyclerView’a benzer).

@Composable
fun MyLazyColumn() {
    LazyColumn {
        items(50) { index ->
            Text("Satır $index")
        }
    }
}